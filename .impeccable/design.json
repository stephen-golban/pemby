  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Round ink pill in the grotesk; the main action on any surface.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">See pricing <svg viewBox=\"0 0 18 18\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M3 9h11M10 5l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:10px;min-block-size:52px;padding:0 24px;border-radius:var(--radius-full,999px);background:var(--color-ink,#14110d);color:var(--color-ground,#faf6f0);font-family:var(--font-display,'Rethink Sans',sans-serif);font-size:1.1875rem;font-weight:700;letter-spacing:-0.01em;text-decoration:none;transition:transform 160ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary:hover{transform:translateY(-2px)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-focus,#2c4a5e);outline-offset:3px}@media (prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}.ds-btn-primary:hover{transform:none}}"
    },
    {
      "name": "Outline Pill",
      "kind": "button",
      "refersTo": "button-outline-pill",
      "description": "Secondary action in mono: near-miss fixes, Copy, Start over. The Operate-screen workhorse.",
