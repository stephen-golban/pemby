      "html": "<article class=\"ds-card\"><h3 class=\"ds-card-role\">Platform Engineer</h3><p class=\"ds-card-meta\">Northwind · contractor, Georgia</p><ul class=\"ds-card-criteria\"><li><svg viewBox=\"0 0 15 15\" width=\"15\" height=\"15\" aria-hidden=\"true\"><rect width=\"15\" height=\"15\" rx=\"3\" fill=\"currentColor\"/><path d=\"M4 7.5l2.4 2.4L11 5.3\" fill=\"none\" stroke=\"var(--color-plum,#875a70)\" stroke-width=\"1.8\"/></svg>B2B contractors in Georgia</li><li><svg viewBox=\"0 0 15 15\" width=\"15\" height=\"15\" aria-hidden=\"true\"><rect width=\"15\" height=\"15\" rx=\"3\" fill=\"currentColor\"/><path d=\"M4 7.5l2.4 2.4L11 5.3\" fill=\"none\" stroke=\"var(--color-plum,#875a70)\" stroke-width=\"1.8\"/></svg>European timezone overlap</li></ul><div class=\"ds-card-stamps\"><span class=\"ds-stamp\">Example</span><span class=\"ds-card-tag\">Hires from Georgia</span></div></article>",
