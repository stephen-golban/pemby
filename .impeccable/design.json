    {
      "name": "CV Drop Zone",
      "kind": "custom",
      "refersTo": "drop-zone",
      "description": "The product's primary action: drop a CV, no account.",
      "html": "<div class=\"ds-drop\"><button class=\"ds-drop-trigger\" type=\"button\"><svg class=\"ds-drop-glyph\" viewBox=\"0 0 34 34\" aria-hidden=\"true\"><path d=\"M17 22V8M11 14l6-6 6 6M8 22v4h18v-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span class=\"ds-drop-title\">Drop your CV</span><span class=\"ds-drop-caption\">No account needed. Deleted after 24 hours unless you sign up.</span></button></div>",
