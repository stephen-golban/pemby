# Pemby environment variables: names only, never values.
# Real values live in Railway (per environment). Local dev gets them via `railway run`
# (see scripts/dev-staging.sh), so you normally do not need a local .env file.

# --- Runtime ---
# production | staging | development
APP_ENV=

# --- Database (Railway Postgres) ---
# Private network URL, used inside Railway.
DATABASE_URL=
# Public proxy URL, used from a laptop against staging.
DATABASE_PUBLIC_URL=

# --- Auth (Better Auth) ---
# At least 32 random characters (`openssl rand -base64 32`). Required; auth endpoints fail without it.
BETTER_AUTH_SECRET=
# Public origin of the web app, e.g. https://staging.pemby.app. Trusted origins default to it.
BETTER_AUTH_URL=
# Optional: extra comma-separated origins allowed to call /api/auth/*.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Staging protection and owner-only access gate ---
# HTTP Basic Auth on staging (APP_ENV=staging). If either is missing, staging answers 503.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
# Comma-separated, case-insensitive emails allowed on product routes before the beta opens.
OWNER_ALLOWLIST_EMAILS=
# The owner gate is always on in production. Set to `on` to enable it on staging or development.
OWNER_GATE=
# Optional: cap alert email; defaults to the first OWNER_ALLOWLIST_EMAILS entry.
OWNER_ALERT_EMAIL=

# --- Cloudflare Turnstile (CV drop bot check) ---
# Site key for the browser widget. Cloudflare test keys work locally (1x00000000000000000000AA passes).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side siteverify secret. Missing: CV routes answer 503 `unavailable`.
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames a solved widget may come from, e.g. staging.pemby.app,pemby.app.
# Required outside development (the CV routes answer 503 without it); unset in development accepts
# any hostname, which is what Cloudflare's test keys report.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- OpenRouter ---
# Public key: public job posts only. Private key: anything with personal data (ZDR enforced).
OPENROUTER_KEY_PUBLIC=
OPENROUTER_KEY_PRIVATE=
# Optional: 0-3, default 3. May only lower the cap.
AI_DAILY_CAP_USD=
# Encrypts a user's own OpenRouter key at rest (AES-256-GCM). 32 random bytes, base64:
# `openssl rand -base64 32`. It must base64-DECODE to exactly 32 bytes — a 24-byte secret encodes to
# 32 characters and would be accepted as a valid key with a third less entropy and no error, which is
# why `assertUserKeySecret` decodes and checks the length. Rotating it makes every stored key
# undecryptable and everyone has to reconnect. **Never NEXT_PUBLIC_***: it is the secret that guards
# other people's API keys.
AI_USER_KEY_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Sender for verification email, e.g. "Pemby <hello@pemby.app>".
EMAIL_FROM=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# bot service: secret_token for setWebhook, checked against X-Telegram-Bot-Api-Secret-Token.
# 32+ chars of A-Z a-z 0-9 _ - (python3 -c 'import secrets; print(secrets.token_urlsafe(48))').
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_CHANNEL=
OWNER_TELEGRAM_CHAT_ID=
# The bot's @username, without the @ (5-32 of A-Z a-z 0-9 _). apps/web builds the account-linking
# deep link `t.me/<username>?start=<token>` from it; /settings says Telegram is unavailable without
# it. Not a secret, but not NEXT_PUBLIC either: the link is minted server-side with its token.
TELEGRAM_BOT_USERNAME=

# --- Private config (prompts, scoring weights, source lists; not in this repo) ---
PRIVATE_CONFIG_REPO=
PRIVATE_CONFIG_REF=
PRIVATE_CONFIG_TOKEN=
# Local development: PRIVATE_CONFIG_DIR=./private-config.example (placeholder content, refused outside development)
PRIVATE_CONFIG_DIR=

# --- Worker: job ingestion (optional; defaults in apps/worker/src/env.ts) ---
# Hours between full reads of every enabled board (1-12, default 6; best as a divisor of 24).
INGEST_INTERVAL_HOURS=
# verify-live re-reads a board when an open job was last verified longer ago than this (1-10, default 10).
VERIFY_LIVE_MAX_AGE_HOURS=
# Board reads running at once per ATS queue in one worker process (1-10, default 2; greenhouse, lever and ashby always 1).
INGEST_CONCURRENCY=
# Comma-separated ATS kinds not to read, e.g. smartrecruiters (default: none).
INGEST_DISABLED_ATS=
# Comma-separated private source lists that supply boards (default: ats-boards).
INGEST_SOURCE_LISTS=

# --- Worker: job enrichment (optional; defaults in apps/worker/src/enrich/env.ts) ---
# "true" registers the enrich sweep schedule; anything else leaves it off (default off).
ENRICH_ENABLED=
# Jobs enqueued per sweep, every 20 minutes (1-200, default 10; keeps daily model spend bounded).
ENRICH_SWEEP_LIMIT=
# Optional hard stop: no new job is enriched once job_enrichment has this many rows (staging
# sample). Re-enriching an existing row is still allowed. Unset for no limit.
ENRICH_SAMPLE_MAX_JOBS=
# enrich.job handlers running at once in this process (1-8, default 2).
ENRICH_CONCURRENCY=

# --- Worker: company evidence (optional; defaults in apps/worker/src/company-evidence/env.ts) ---
# Gates the scheduled sweep only; a flag or manual recheck runs regardless (default off).
COMPANY_EVIDENCE_ENABLED=
# A company is re-checked when its last check is older than this, in days (1-365, default 30).
COMPANY_EVIDENCE_MAX_AGE_DAYS=
# Companies enqueued per sweep, once daily (1-1000, default 50).
COMPANY_EVIDENCE_SWEEP_LIMIT=

# --- Worker: embeddings (phase 07; optional; defaults in apps/worker/src/embed/env.ts) ---
# "true" registers the embed sweep schedule; anything else leaves it off (default off).
EMBED_ENABLED=
# Job postings enqueued per sweep, every 15 minutes (1-500, default 50).
EMBED_SWEEP_LIMIT=
# Profiles enqueued per sweep (1-200, default 20). Separate from the job limit: a profile embedding
# is personal data on the private ZDR key and there are far fewer of them.
EMBED_PROFILE_SWEEP_LIMIT=
# embed.job handlers running at once in this process (1-8, default 2). embed.profile is always 1.
EMBED_CONCURRENCY=
# Per-day ceiling on embedding spend under the global AI cap, in USD (above 0 and at most
# AI_DAILY_CAP_USD's ceiling of 3, default 0.25). A backfill must not starve enrichment or CV parsing.
EMBED_DAILY_BUDGET_USD=

# --- Worker: matcher (phase 07; optional; defaults in apps/worker/src/match/env.ts) ---
# "true" registers the match sweep schedule; anything else leaves it off (default off).
MATCH_ENABLED=
# Newly enriched jobs enqueued per sweep, every 10 minutes (1-2000, default 200). Matching makes no
# model call (PLAN D18), so the ceiling here is database work, not spend.
MATCH_SWEEP_LIMIT=
# match.job handlers running at once in this process (1-8, default 2). match.profile is always 1.
MATCH_CONCURRENCY=
# Candidate jobs loaded and scored for one match.profile run (50-5000, default 500).
MATCH_PROFILE_JOB_LIMIT=

# --- Worker: delivery dispatcher (phase 08; optional; defaults in apps/worker/src/deliver/env.ts) ---
# "true" registers the deliver sweep schedule; anything else leaves it off (default off).
DELIVER_ENABLED=
# Comma-separated subset of telegram,email,push (default: all three). A channel whose credentials
# are missing stays off whatever this says; this turns a *configured* channel off.
DELIVER_CHANNELS=
# Messages one channel may send in one drain (1-500, default 50). A drain runs once a minute per
# channel, so the default is 72,000 messages a day per channel.
DELIVER_BATCH_LIMIT=
# `failed` delivery_log rows for one (match, channel) before it is left alone (1-10, default 3).
DELIVER_MAX_ATTEMPTS=
# Seconds after which a claim left behind by a crashed dispatcher is released so a later tick may
# re-send (default 900, max 3600). The minimum is computed in apps/worker/src/deliver/limits.ts from
# the providers' own timeouts and the worker refuses to start below it: a claim released while its
# provider call is still in flight makes the next tick send the same card again.
DELIVER_STALE_CLAIM_SECONDS=
# Global token buckets, messages per second (Telegram 1-30 default 25; Resend 1-10 default 8, its
# team limit is 10 req/s; push 1-100 default 25). Telegram also paces itself to one message a second
# per chat and honours `retry_after` on a 429 through @grammyjs/auto-retry.
DELIVER_TELEGRAM_RATE_PER_SECOND=
DELIVER_EMAIL_RATE_PER_SECOND=
DELIVER_PUSH_RATE_PER_SECOND=
# Absolute origin of the web app that every link in a message is built from, e.g.
# https://staging.pemby.app. Falls back to BETTER_AUTH_URL; one of the two is required when enabled.
# Phase 09's `tracker.sync` reads this and TELEGRAM_BOT_TOKEN too, to edit an already-sent card's
# buttons when its tracker column changes. Neither is a new variable and neither gates the queue:
# without the token the job logs and completes, without an origin the tracker button is left off.
DELIVER_APP_URL=
# Comma-separated user ids treated as pass holders until phase 10 brings real passes. The only way a
# delivery is instant today, and what makes the instant-vs-delayed split provable from two accounts.
# **Read by the matcher as well as the dispatcher.** The matcher writes matches.deliver_after from
# it, and that column is the only thing the dispatcher gates on, so a change here only affects match
# rows written after it: an account added to this list keeps its existing rows' +24h window.
DELIVER_TEST_PASS_HOLDERS=
# At least 32 random characters (`openssl rand -base64 32`). Signs the unsubscribe and flag links a
# match email carries. **The worker and the web service must be given the identical value**: the
# worker mints, apps/web verifies. Missing or shorter and email delivery stays off.
DELIVERY_LINK_SECRET=

# --- Worker: flag rules (phase 09; optional; defaults in apps/worker/src/flags/env.ts) ---
# "true" registers the flags sweep schedule; anything else leaves it off (default off). The two
# queues are created either way, so a flag filed while this is off is left `open` for the owner's
# review queue rather than lost.
FLAGS_ENABLED=
# Flags claimed and enqueued per sweep, every 5 minutes (1-200, default 20).
FLAGS_SWEEP_LIMIT=
# flags.process handlers running at once in this process (1-8, default 2).
FLAGS_CONCURRENCY=
# A claim not resolved within this long is re-offered (1-240, default 30). The claim is taken by the
# sweep and released by the handler, so this has to cover the queue wait as well as the rule's own
# run — a "closed or fake" flag reads a whole ATS board. Below 1 the worker refuses to start.
FLAGS_CLAIM_STALE_MINUTES=
# Claims one flag may collect before the rules give up and leave it for the owner (1-20, default 5).
# Each cycle can queue a model call, so this bounds what one poisonous flag can spend.
FLAGS_MAX_ATTEMPTS=
# Open flags re-weighed per sweep (0-5000, default 200). 0 turns the weighting pass off, and then
# every flag counts its stored weight — which for a flag filed before phase 09 is the default of 1.
FLAGS_REWEIGH_LIMIT=

# --- Web push (phase 08; VAPID, RFC 8292) ---
# Application server key pair (`npx web-push generate-vapid-keys`). Push is off without both.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service: a mailto: or https:// URL. Required when the keys are set.
VAPID_SUBJECT=
# The public half again, for the browser's subscribe() call. Same value as VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- CV drop (phase 06; web and worker) ---
# "true" turns on POST /api/cv, POST /api/cv/text, GET /api/cv/:id and the worker's cv queues.
# Ignored on APP_ENV=production, where the drop is always off (routes 404, no cv workers).
CV_DROP_ENABLED=
# Anonymous CV submissions accepted per hour across the whole site (1-100000, default 60): a cap
# on model spend that a botnet with many IPs and sessions cannot walk around.
CV_ANON_GLOBAL_PER_HOUR=
# Hours an anonymous user's CV (or an anonymous user with no CV) is kept before cv.cleanup deletes
# it (0-720, default 24). The worker reads it on every cleanup run.
CV_ANON_TTL_HOURS=
# Per-day ceiling on CV-parse spend under the global AI cap, in USD (above 0 and at most
# AI_DAILY_CAP_USD's ceiling of 3, default 1.00). Read in apps/worker/src/cv/parse/parse-cv.ts.
CV_PARSE_DAILY_BUDGET_USD=

# --- Bucket (CV files; Railway bucket reference variables, S3 API, private) ---
# Bucket name.
BUCKET=
# S3 endpoint, e.g. https://t3.storageapi.dev (virtual-hosted-style URLs).
ENDPOINT=
# Region, e.g. auto.
REGION=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
