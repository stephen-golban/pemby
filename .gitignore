# --- Secrets (repo is public) ---
.env
.env.*
!.env.example

# --- Impeccable design artifacts ---
# Only the approved landing comps and their sidecars are tracked.
# Every other comp is a spent round: kept locally, never in public history.
.impeccable/mocks/*.png
!.impeccable/mocks/band-light.png
!.impeccable/mocks/band-dark.png

# Rejected direction round
.impeccable/mocks/decision/

# Local decision-page server state (session scratch, not project truth)
.impeccable/questions/

# Build/review state produced during a comp-led build
.impeccable/build/
.impeccable/review/

# Machine-local impeccable overrides
.impeccable/config.local.json

# --- OS noise ---
.DS_Store

# Third-party reference screenshots (kept local, never published)
docs/research/desertant/

# --- Dependencies and build output ---
node_modules/
.next/
.turbo/
dist/
coverage/
*.tsbuildinfo
.vercel/
# Generated by Next.js on dev/build/typegen (Next docs recommend ignoring it)
next-env.d.ts

# Agent worktrees (local only)
.claude/worktrees/
